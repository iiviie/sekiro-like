--!strict
local BossService = require(script.BossService)
local BotService = require(script.BotService)
local CombatService = require(script.CombatService)
local CosmeticService = require(script.CosmeticService)
local DevHooks = require(script.DevHooks)
local DuelService = require(script.DuelService)
local Economy = require(script.Economy)
local LeaderboardService = require(script.LeaderboardService)
local LightingProfile = require(game:GetService("ReplicatedStorage").Shared.LightingProfile)
local LobbyBuilder = require(script.LobbyBuilder)
local LobbyService = require(script.LobbyService)
local MapBuilder = require(script.MapBuilder)
local Monetization = require(script.Monetization)
local PassService = require(script.PassService)
local ProgressService = require(script.ProgressService)
local Ronin = require(script.Ronin)
local RoundService = require(script.RoundService)
local ShopService = require(script.ShopService)
local StatsService = require(script.StatsService)
local Telemetry = require(script.Telemetry)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

LightingProfile.apply()
BossService.stash() -- boss clips stay server-side until a fight needs them
local buildStarted = os.clock()
MapBuilder.build()
LobbyBuilder.build()
ReplicatedStorage:SetAttribute("WorldBuildSeconds", math.round((os.clock() - buildStarted) * 100) / 100)
CombatService.start()
BotService.start()
StatsService.start()
ProgressService.start()
Economy.start()
Monetization.start()
PassService.start()
ShopService.start()
LobbyService.start()
CosmeticService.start()
Ronin.start()
LeaderboardService.start()
RoundService.start()
DuelService.start()
BossService.start()
Telemetry.start()
DevHooks.start()

-- The world is built and every service is up: the title card (client/WorldGate) holds its
-- "press any key" until this arrives, with the lobby's size so it can tell when it has it all.
local lobby = workspace:FindFirstChild("Lobby")
ReplicatedStorage:SetAttribute("WorldParts", if lobby then #lobby:GetDescendants() else 0)
ReplicatedStorage:SetAttribute("WorldReady", true)
