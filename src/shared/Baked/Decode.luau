	"LeftAnkle",
}
Decode.UPPER =
	{ "Waist", "Neck", "RightShoulder", "RightElbow", "RightWrist", "LeftShoulder", "LeftElbow", "LeftWrist" }

function Decode.pose(row: { any }): { [string]: CFrame }
