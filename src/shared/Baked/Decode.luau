	local k = 0
	for _, joint in joints do
		if joint == "Root" then
			pose.Root = CFrame.new(v[k + 1], v[k + 2], v[k + 3], v[k + 4], v[k + 5], v[k + 6], v[k + 7])
			k += 7
		else
			pose[joint] = CFrame.new(0, 0, 0, v[k + 1], v[k + 2], v[k + 3], v[k + 4])
			k += 4
		end
	end
	return pose
end

return Decode
