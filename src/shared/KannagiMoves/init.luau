			if cached then
				return cached
			end
			local child = script:FindFirstChild(id)
			if child == nil or not child:IsA("ModuleScript") then
				return nil
			end
			local boss = (require :: any)(child) :: Boss
			bossCache[id] = boss
			return boss
		end,
	}) :: any
