export type Hit = {
	at: number, -- seconds from move start (the PlayActionAnimation call) to collider ON
	dur: number, -- collider ON duration
	type: string, -- "Normal" | "Tsuki" (thrust) | "Gedan" (sweep)
	damageScale: number,
	postureScale: number,
	reTScale: number, -- posture the ATTACKER takes when this hit is deflected = reTScale * defender.attackBaseTDamage
	reaction: string, -- victim flinch: Small | Middle | Large | Gedan
	guardReaction: string, -- BackSmall | BackMiddle | BackLarge
	deflectReaction: string, -- defender's deflect anim: RightSmall | RightMiddle | LeftSmall | LeftMiddle | BackLarge
	recoil: string, -- attacker recoil when deflected: None (string continues) | RightSmall | LeftSmall
	knockback: number, -- victim slide in studs (0.25 * KnockBackPower cm over 0.5 s, ease-out)
	knockbackCm: number, -- raw KnockBackPower
	rotation: string,
	weapon: number, -- 1 main, 2 Niten's second katana
	damage: number?, -- damageScale * attackBaseDamage (phase-1 base)
	postureDamage: number?,
	deflectPostureToAttacker: number?,
}
export type Window = { from: number, to: number, level: number?, weapon: number?, speed: number? }
export type Track = { from: number, to: number, turnSpeed: number, kind: string }
export type Move = {
	anim: string,
	rateScale: number,
	params: { pause: boolean, blendIn: number, blendOut: number, rate: number, trigger: number, start: number }?,
	duration: number, -- seconds until the action ends (AI / input free)
	hold: number?, -- frozen first frame (PauseBlendIn)
	windup: number?, -- first hit .at
	recovery: number?, -- duration - end of last hit
	hits: { Hit },
	track: { Track },
	cancels: { [string]: { Window } }?, -- player only: R1 attack, L1 guard, A jump, B dodge, Y heal
	l1Hold: { number }?,
	flags: { [string]: any },
	root: { fwd: number, right: number, up: number, yaw: number, curve: { { number } } }?,
	shakes: { { [string]: any } },
	sounds: { { [string]: any } },
	events: { { [string]: any } },
	blendCurve: { curve: string, option: string? }?,
	note: string?,
}
export type Boss = {
